# Since configuration
# Copy this file to .env: `cp .env.example .env` (PowerShell: `Copy-Item .env.example .env`)
#
# Demo mode is automatic when an LLM key or a search key is missing. It uses a
# small curated CRM/Postgres corpus, labels every source "demo", and never calls
# the network. Live mode requires ONE LLM key AND ONE search key.

# Server
PORT=8787
DATABASE_PATH=./data/since.db
# Default timezone for new conversations. The browser sends its own timezone
# per request; this is the fallback for API clients.
USER_TZ=UTC

# --- LLM (choose one) -------------------------------------------------------
# OpenAI (paid). https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL_FAST=gpt-4.1-mini
# MODEL_SMART=gpt-4.1

# Groq (free tier, recommended free alternative, OpenAI-compatible).
# Get a key: https://console.groq.com/keys
# GROQ_API_KEY=
# MODEL_FAST=llama-3.1-8b-instant
# MODEL_SMART=llama-3.3-70b-versatile

# OpenRouter (free models available with :free suffix; rate-limited).
# Get a key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# MODEL_FAST=meta-llama/llama-3.1-8b-instruct:free
# MODEL_SMART=meta-llama/llama-3.3-70b-instruct:free

# Google Gemini via OpenAI-compatible endpoint (free tier).
# Get a key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# MODEL_FAST=gemini-2.0-flash
# MODEL_SMART=gemini-2.0-flash

# Optional overrides for any provider above:
# OPENAI_BASE_URL=
# MODEL_FAST=
# MODEL_SMART=

# --- Web search (choose one) ------------------------------------------------
# Tavily returns page content in results (best grounding quality).
# Get a key: https://tavily.com
TAVILY_API_KEY=

# Brave Search API (free tier alternative; descriptions/snippets as content).
# Get a key: https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=
