# Since configuration
# Copy this file to .env: `cp .env.example .env` (PowerShell: `Copy-Item .env.example .env`)
#
# Demo mode is automatic when either key below is missing. It uses a small,
# curated CRM/Postgres corpus, labels every source "demo", and never calls the
# network. Live mode requires BOTH OPENAI_API_KEY and TAVILY_API_KEY.

# Server
PORT=8787
DATABASE_PATH=./data/since.db
# Default timezone for new conversations. The browser sends its own timezone
# per request; this is the fallback for API clients.
USER_TZ=UTC

# Model provider (OpenAI or an OpenAI-compatible /chat/completions endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Fast model: routing, citation checks, claim extraction, claim comparison.
MODEL_FAST=gpt-4.1-mini
# Smart model: streamed fresh-answer synthesis.
MODEL_SMART=gpt-4.1

# Web search: Tavily returns page content, so no second fetch/browser tool is needed.
TAVILY_API_KEY=
